# Másold .env néven, és írd be a kulcsot. A .env nem kerülhet a repositoryba.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60
LLM_CONCURRENCY=4

# --- Saját cég (ez alapján dől el az irány) ---
COMPANY_NAME=Nordwind Solutions Kft.
COMPANY_TAX_NUMBER=26481937-2-43
COMPANY_EU_VAT=HU26481937

# --- MNB árfolyamok ---
MNB_URL=http://www.mnb.hu/arfolyamok.asmx
MNB_TIMEOUT_SECONDS=20
MNB_CONCURRENCY=2
# Ennyi nappal korábbi jegyzésig keresünk árfolyamot (hétvége, ünnepnap miatt)
MNB_LOOKBACK_DAYS=31

# --- Kimutatás ---
REPORT_CURRENCY=HUF
DEFAULT_LOCALE=hu

# --- Rendszer ---
DATABASE_PATH=data/app.db
# Egy fájl maximális mérete MB-ban
MAX_UPLOAD_MB=20
# Egyszerre feldolgozott dokumentumok száma
PROCESSING_CONCURRENCY=4
LOG_LEVEL=INFO
# text vagy json
LOG_FORMAT=text

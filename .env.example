# Másold .env néven, és írd be a kulcsot. A .env nélkül a `docker compose` nem indul el.
# A .env nem kerülhet a repositoryba.
# Érvénytelen érték esetén (pl. szám helyett szöveg) az alkalmazás az alapértéket használja, és ezt
# indításkor figyelmeztetésként naplózza. A KÖTELEZŐ (alapérték nélküli) mezők hibájánál nem indul el.

# --- Webes elérés ---
# A gépen ezen a porton érhető el az alkalmazás: http://localhost:<APP_PORT> (alapérték: 8080)
APP_PORT=8080

# --- LLM (OpenRouter) ---
# KÖTELEZŐ: üres kulccsal az alkalmazás nem indul el (adatkinyerés nélkül nincs mit feldolgozni)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60
LLM_CONCURRENCY=4

# --- Saját cég (KÖTELEZŐ, nincs alapérték; ez alapján dől el az irány) ---
COMPANY_NAME=Nordwind Solutions Kft.
COMPANY_TAX_NUMBER=26481937-2-43
COMPANY_EU_VAT=HU26481937

# --- MNB árfolyamok ---
MNB_URL=http://www.mnb.hu/arfolyamok.asmx
MNB_TIMEOUT_SECONDS=20
MNB_CONCURRENCY=2
# Ennyi nappal korábbi jegyzésig keresünk árfolyamot (hétvége, ünnepnap miatt)
MNB_LOOKBACK_DAYS=31
# Ennyi napig használjuk a tárolt, MNB által jegyzett devizalistát, utána újra lekérjük
MNB_CURRENCIES_TTL_DAYS=7

# --- Kimutatás ---
# ISO 4217 devizakód (alapérték: HUF)
REPORT_CURRENCY=HUF
# A felület nyelve, ehhez igazodik a szám- és dátumformátum (alapérték: hu).
# Csak olyan nyelv adható meg, amelyhez van fájl az app/web/locales mappában (pl. hu.json);
# ha nincs, az alkalmazás figyelmeztetéssel a hu-ra áll vissza.
DEFAULT_LOCALE=hu

# --- Rendszer ---
# Egy fájl maximális mérete MB-ban
MAX_UPLOAD_MB=20
# Egyszerre feldolgozott dokumentumok száma
PROCESSING_CONCURRENCY=4
# Ennyi dokumentum várakozhat a feldolgozási sorban; ha megtelt, a feltöltés megvárja a szabad helyet
PROCESSING_QUEUE_SIZE=8
